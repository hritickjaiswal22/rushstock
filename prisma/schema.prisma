// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique @db.VarChar(100)
  password  String   @db.Text
  name      String   @db.VarChar(100)
  role      Role     @default(USER)
  createdAt DateTime @map("created_at") @default(now()) @db.Timestamptz
  updatedAt DateTime @map("updated_at") @updatedAt @db.Timestamptz

  bookings Booking[]
  sales    Sale[]    @relation("SaleAuthor")

  @@map("users")
}

model Product {
  id          String   @id @default(uuid()) @db.Uuid
  title       String   @db.VarChar(150)
  description String?  @db.Text
  price       Decimal  @db.Decimal(15, 2)
  createdAt   DateTime @map("created_at") @default(now()) @db.Timestamptz
  updatedAt   DateTime @map("updated_at") @updatedAt @db.Timestamptz

  sales Sale[]

  @@map("products")
}

model Sale {
  id            String   @id @default(uuid()) @db.Uuid
  authorId      String   @map("author_id") @db.Uuid
  productId     String   @map("product_id") @db.Uuid
  startAt       DateTime @map("start_at") @db.Timestamptz
  endAt         DateTime @map("end_at") @db.Timestamptz
  stockQuantity Int      @map("stock_quantity") @db.Integer
  unitPrice     Decimal  @map("unit_price") @db.Decimal(15, 2)
  createdAt     DateTime @map("created_at") @default(now()) @db.Timestamptz
  updatedAt     DateTime @map("updated_at") @updatedAt @db.Timestamptz

  author    User     @relation("SaleAuthor", fields: [authorId], references: [id])
  product   Product  @relation(fields: [productId], references: [id])
  bookings  Booking[]

  @@unique([productId, startAt, endAt])
  @@index([startAt, endAt])
  @@index([productId, startAt, endAt])
  @@map("sales")
}

model Booking {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  saleId    String   @map("sale_id") @db.Uuid
  quantity  Int      @db.SmallInt
  createdAt DateTime @map("created_at") @default(now()) @db.Timestamptz
  updatedAt DateTime @map("updated_at") @updatedAt @db.Timestamptz

  user User @relation(fields: [userId], references: [id])
  sale Sale @relation(fields: [saleId], references: [id])

  @@unique([userId, saleId])
  @@map("bookings")
}