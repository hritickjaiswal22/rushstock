// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum OrderStatus {
  PENDING
  EXPIRED
  SUCCESS
  FAILED
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique @db.VarChar(100)
  password  String   @db.Text
  name      String   @db.VarChar(100)
  role      Role     @default(USER)
  createdAt DateTime @map("created_at") @default(now()) @db.Timestamptz
  updatedAt DateTime @map("updated_at") @updatedAt @db.Timestamptz

  sales  Sale[]    @relation("SaleAuthor")
  orders Order[]

  @@map("users")
}

model Product {
  id          String   @id @default(uuid()) @db.Uuid
  title       String   @db.VarChar(150)
  description String?  @db.Text
  price       Decimal  @db.Decimal(15, 2)
  createdAt   DateTime @map("created_at") @default(now()) @db.Timestamptz
  updatedAt   DateTime @map("updated_at") @updatedAt @db.Timestamptz

  sales Sale[]

  @@map("products")
}

model Sale {
  id            String   @id @default(uuid()) @db.Uuid
  authorId      String   @map("author_id") @db.Uuid
  productId     String   @map("product_id") @db.Uuid
  startAt       DateTime @map("start_at") @db.Timestamptz
  endAt         DateTime @map("end_at") @db.Timestamptz
  stockQuantity Int      @map("stock_quantity") @db.Integer
  unitPrice     Decimal  @map("unit_price") @db.Decimal(15, 2)
  createdAt     DateTime @map("created_at") @default(now()) @db.Timestamptz
  updatedAt     DateTime @map("updated_at") @updatedAt @db.Timestamptz

  author  User    @relation("SaleAuthor", fields: [authorId], references: [id])
  product Product @relation(fields: [productId], references: [id])
  orders  Order[]

  @@unique([productId, startAt, endAt])
  @@index([startAt, endAt])
  @@index([productId, startAt, endAt])
  @@map("sales")
}

model Order {
  id            String      @id @default(uuid()) @db.Uuid
  saleId        String      @map("sale_id") @db.Uuid
  userId        String      @map("user_id") @db.Uuid
  idempotencyId String      @unique @map("idempotency_id") @db.Text
  quantity      Int         @db.SmallInt
  status        OrderStatus @default(PENDING)
  expiresAt     DateTime    @map("expires_at") @db.Timestamptz
  createdAt     DateTime    @map("created_at") @default(now()) @db.Timestamptz
  updatedAt     DateTime    @map("updated_at") @updatedAt @db.Timestamptz

  sale Sale @relation(fields: [saleId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@index([saleId, userId])
  @@map("orders")
}